<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Payload, который внедряется в House Flipper (Unity / Mono).
    Сборка по умолчанию: по эталонным Unity-библиотекам из NuGet (net35, совместимо с обоими рантаймами Mono).
    Сборка под ВАШУ версию игры (надёжнее):  dotnet build -p:GameDir="C:\Games\House Flipper"
  -->
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>HFTrainer.Payload</AssemblyName>
    <RootNamespace>HFTrainer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <NoWarn>$(NoWarn);CS0649;CS0618;MSB3277;CS1701;CS1702</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GameDir)' != ''">
    <GameManaged>$([System.IO.Directory]::GetDirectories('$(GameDir)', '*_Data')[0])\Managed</GameManaged>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Вариант 1: эталонные сборки Unity из NuGet -->
  <ItemGroup Condition="'$(GameDir)' == ''">
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" PrivateAssets="all" IncludeAssets="none" GeneratePathProperty="true" />
    <Reference Include="UnityEngine.CoreModule"    HintPath="$(PkgUnityEngine_Modules)\lib\net35\UnityEngine.CoreModule.dll"    Private="false" />
    <Reference Include="UnityEngine.IMGUIModule"   HintPath="$(PkgUnityEngine_Modules)\lib\net35\UnityEngine.IMGUIModule.dll"   Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(PkgUnityEngine_Modules)\lib\net35\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(PkgUnityEngine_Modules)\lib\net35\UnityEngine.TextRenderingModule.dll" Private="false" />
  </ItemGroup>

  <!-- Вариант 2: библиотеки из папки установленной игры -->
  <ItemGroup Condition="'$(GameDir)' != ''">
    <Reference Include="UnityEngine.CoreModule"    HintPath="$(GameManaged)\UnityEngine.CoreModule.dll"    Private="false" />
    <Reference Include="UnityEngine.IMGUIModule"   HintPath="$(GameManaged)\UnityEngine.IMGUIModule.dll"   Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(GameManaged)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GameManaged)\UnityEngine.TextRenderingModule.dll" Private="false" />
  </ItemGroup>
</Project>
